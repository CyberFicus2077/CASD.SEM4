using System;
using System.Collections.Generic;
using System.IO;
using System.Text.RegularExpressions; 

namespace Task22
{
    public class Entry<K, V>
    {
        public K Key;
        public V Value;
        public Entry<K, V> Next;
        public Entry(K key, V value)
        {
            this.Key = key;
            this.Value = value;
            this.Next = null;
        }
    }

    public class MyHashMap<K, V>
    {
        private Entry<K, V>[] table;
        private int _size;
        private float loadFactor;

        public MyHashMap(int initialCapacity, float loadFactor)
        {
            this.table = new Entry<K, V>[initialCapacity];
            this.loadFactor = loadFactor;
            this._size = 0;
        }

        private int GetIndex(object key)
        {
            int hash = key.GetHashCode();
            if (hash < 0) hash = -hash;
            return hash % table.Length;
        }

        public void put(K key, V value)
        {
            if (_size >= table.Length * loadFactor) Resize();

            int index = GetIndex(key);
            Entry<K, V> current = table[index];

            while (current != null)
            {
                if (current.Key.Equals(key))
                {
                    current.Value = value; 
                    return;
                }
                current = current.Next;
            }

            Entry<K, V> newEntry = new Entry<K, V>(key, value);
            newEntry.Next = table[index];
            table[index] = newEntry;
            _size++;
        }

        public V get(object key)
        {
            int index = GetIndex(key);
            Entry<K, V> current = table[index];
            while (current != null)
            {
                if (current.Key.Equals(key)) return current.Value;
                current = current.Next;
            }
            return default(V);
        }

        public bool containsKey(object key)
        {
            int index = GetIndex(key);
            Entry<K, V> current = table[index];
            while (current != null)
            {
                if (current.Key.Equals(key)) return true;
                current = current.Next;
            }
            return false;
        }

        public List<K> getAllKeys()
        {
            List<K> keys = new List<K>();
            for (int i = 0; i < table.Length; i++)
            {
                Entry<K, V> current = table[i];
                while (current != null)
                {
                    keys.Add(current.Key);
                    current = current.Next;
                }
            }
            return keys;
        }

        private void Resize()
        {
            Entry<K, V>[] oldTable = table;
            table = new Entry<K, V>[oldTable.Length * 2];
            _size = 0;
            for (int i = 0; i < oldTable.Length; i++)
            {
                Entry<K, V> current = oldTable[i];
                while (current != null)
                {
                    put(current.Key, current.Value);
                    current = current.Next;
                }
            }
        }
    }

    class Program
    {
        static void Main(string[] args)
        {
            MyHashMap<string, int> tagMap = new MyHashMap<string, int>(16, 0.75f);

            string reg = @"</?([a-zA-Z][a-zA-Z0-9]*)>";

            string fileName = "input.txt";

            if (!File.Exists(fileName))
            {
                Console.WriteLine("Файл input.txt не найден. Создам пустой для примера.");
                File.WriteAllText(fileName, "<html> <BODY> Хелло, амиго </P> </Body> </html> <html>");
            }

            try
            {
                StreamReader reader = new StreamReader(fileName);
                string line;
                while ((line = reader.ReadLine()) != null)
                {
                    MatchCollection matches = Regex.Matches(line, reg);

                    foreach (Match m in matches)
                    {
                        string tagName = m.Groups[1].Value;

                        tagName = tagName.ToLower();

                        if (tagMap.containsKey(tagName))
                        {
                            int count = tagMap.get(tagName);
                            tagMap.put(tagName, count + 1);
                        }
                        else
                        {
                            tagMap.put(tagName, 1);
                        }
                    }
                }
                reader.Close(); 
            }
            catch (Exception ex)
            {
                Console.WriteLine("Ошибка при чтении: " + ex.Message);
            }

            Console.WriteLine("Результаты:");
            List<string> keys = tagMap.getAllKeys();
            for (int i = 0; i < keys.Count; i++)
            {
                string key = keys[i];
                int val = tagMap.get(key);
                Console.WriteLine("Тег <" + key + "> встретился " + val + " раз(а)");
            }

            Console.ReadLine();
        }
    }
}
