using System;
using System.Collections.Generic;
using System.Linq;

class Graph
{
    private int n;
    private List<int>[] g;

    private class FlowEdge
    {
        public int To;         
        public int Capacity;   
        public int Flow;      
        public int Rev;        

        public FlowEdge(int to, int capacity, int flow, int rev)
        {
            To = to;
            Capacity = capacity;
            Flow = flow;
            Rev = rev;
        }
    }

    private List<FlowEdge>[] flowGraph;

    public Graph(int vertices)
    {
        n = vertices;
        g = new List<int>[vertices];
        flowGraph = new List<FlowEdge>[vertices];

        for (int i = 0; i < vertices; i++)
        {
            g[i] = new List<int>();
            flowGraph[i] = new List<FlowEdge>();
        }
    }

    public void AddEdge(int u, int v)
    {
        g[u].Add(v);
        g[v].Add(u);
    }

    public void AddDirectedEdge(int u, int v)
    {
        g[u].Add(v);
    }

    public List<int>[] GetAdjList() => g;

    // Уэлш-Пауэлл
    public void WelshPowellColoring()
    {
        int[] color = new int[n];
        for (int i = 0; i < n; i++)
            color[i] = -1;

        var sorted = Enumerable.Range(0, n)
            .Select(v => new { v, deg = g[v].Count })
            .OrderByDescending(x => x.deg)
            .ToList();

        int curColor = 0;

        while (color.Any(c => c == -1))
        {
            int first = sorted.First(item => color[item.v] == -1).v;
            color[first] = curColor;

            foreach (var item in sorted)
            {
                int v = item.v;
                if (color[v] == -1)
                {
                    bool ok = true;
                    for (int i = 0; i < n; i++)
                    {
                        if (color[i] == curColor && g[v].Contains(i))
                        {
                            ok = false;
                            break;
                        }
                    }
                    if (ok)
                        color[v] = curColor;
                }
            }
            curColor++;
        }

        Console.WriteLine("Результат раскраски (Уэлш-Пауэлл):");
        for (int i = 0; i < n; i++)
            Console.WriteLine($"Вершина {i} ---> Цвет {color[i]}");
        Console.WriteLine($"Всего цветов: {curColor}");
    }

    // Тарьян 
    public void TarjanSCC()
    {
        int[] index = new int[n];
        int[] lowlink = new int[n];
        bool[] onStack = new bool[n];
        Stack<int> stack = new Stack<int>();
        List<List<int>> sccList = new List<List<int>>();

        for (int i = 0; i < n; i++)
            index[i] = -1;

        int currentIndex = 0;

        for (int i = 0; i < n; i++)
        {
            if (index[i] == -1)
                StrongConnect(i, ref currentIndex, index, lowlink, onStack, stack, sccList);
        }

        Console.WriteLine("\nКомпоненты сильной связности (алгоритм Тарьяна):");
        int compNum = 1;
        foreach (var comp in sccList)
        {
            Console.WriteLine($"Компонента {compNum}: {{ {string.Join(", ", comp)} }}");
            compNum++;
        }
    }

    private void StrongConnect(int v, ref int currentIndex, int[] index, int[] lowlink,
        bool[] onStack, Stack<int> stack, List<List<int>> sccList)
    {
        index[v] = currentIndex;
        lowlink[v] = currentIndex;
        currentIndex++;
        stack.Push(v);
        onStack[v] = true;

        foreach (int w in g[v])
        {
            if (index[w] == -1)
            {
                StrongConnect(w, ref currentIndex, index, lowlink, onStack, stack, sccList);
                lowlink[v] = Math.Min(lowlink[v], lowlink[w]);
            }
            else if (onStack[w])
            {
                lowlink[v] = Math.Min(lowlink[v], index[w]);
            }
        }

        if (lowlink[v] == index[v])
        {
            List<int> component = new List<int>();
            int w;
            do
            {
                w = stack.Pop();
                onStack[w] = false;
                component.Add(w);
            } while (w != v);
            sccList.Add(component);
        }
    }

    // алгоритм Диница
    public void AddFlowEdge(int from, int to, int capacity)
    {
        FlowEdge forward = new FlowEdge(to, capacity, 0, flowGraph[to].Count);
        FlowEdge backward = new FlowEdge(from, 0, 0, flowGraph[from].Count);

        flowGraph[from].Add(forward);
        flowGraph[to].Add(backward);
    }

    private bool BfsLevelGraph(int source, int sink, int[] level)
    {
        for (int i = 0; i < n; i++)
            level[i] = -1;

        Queue<int> queue = new Queue<int>();
        level[source] = 0;
        queue.Enqueue(source);

        while (queue.Count > 0)
        {
            int v = queue.Dequeue();

            foreach (var edge in flowGraph[v])
            {
                if (level[edge.To] < 0 && edge.Flow < edge.Capacity)
                {
                    level[edge.To] = level[v] + 1;
                    queue.Enqueue(edge.To);
                }
            }
        }

        return level[sink] >= 0;
    }

    private int SendFlow(int v, int sink, int flow, int[] start, int[] level)
    {
        if (v == sink)
            return flow;

        for (; start[v] < flowGraph[v].Count; start[v]++)
        {
            FlowEdge edge = flowGraph[v][start[v]];

            if (level[edge.To] == level[v] + 1 && edge.Flow < edge.Capacity)
            {
                int currentFlow = Math.Min(flow, edge.Capacity - edge.Flow);
                int tempFlow = SendFlow(edge.To, sink, currentFlow, start, level);

                if (tempFlow > 0)
                {
                    edge.Flow += tempFlow;
                    flowGraph[v][start[v]] = edge;

                    FlowEdge reverseEdge = flowGraph[edge.To][edge.Rev];
                    reverseEdge.Flow -= tempFlow;
                    flowGraph[edge.To][edge.Rev] = reverseEdge;

                    return tempFlow;
                }
            }
        }

        return 0;
    }

    public void DinicMaxFlow(int source, int sink)
    {
        if (source == sink)
        {
            Console.WriteLine("Источник и сток совпадают. Максимальный поток = 0");
            return;
        }

        int totalFlow = 0;
        int[] level = new int[n];

        while (BfsLevelGraph(source, sink, level))
        {
            int[] start = new int[n];

            while (true)
            {
                int flow = SendFlow(source, sink, int.MaxValue, start, level);
                if (flow <= 0)
                    break;
                totalFlow += flow;
            }
        }

        Console.WriteLine("\nМаксимальный поток: " + totalFlow);
    }
}

