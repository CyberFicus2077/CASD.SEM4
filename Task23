using System;
using System.Collections.Generic;
using System.IO;
using System.Text.RegularExpressions;

namespace Task23
{
    public enum VarType 
    { 
        Int, 
        Float, 
        Double, 
        Invalid 
    }

    public class VariableInfo
    {
        public VarType Type;
        public string TypeName;
        public string Value;

        public VariableInfo(VarType type, string typeName, string value)
        {
            this.Type = type;
            this.TypeName = typeName;
            this.Value = value;
        }
    }

    public class Entry<K, V>
    {
        public K Key;
        public V Value;
        public Entry<K, V> Next;
        public Entry(K key, V value) 
        {
            this.Key = key;
            this.Value = value; 
        }
    }

    public class MyHashMap<K, V>
    {
        private Entry<K, V>[] table;
        private int _size;
        private float loadFactor;

        public MyHashMap(int initialCapacity, float loadFactor)
        {
            this.table = new Entry<K, V>[initialCapacity];
            this.loadFactor = loadFactor;
            this._size = 0;
        }

        private int GetIndex(object key)
        {
            int hash = (key == null) ? 0 : key.GetHashCode();
            return (hash & 0x7FFFFFFF) % table.Length;
        }

        public void put(K key, V value)
        {
            if (_size >= table.Length * loadFactor) Resize();
            int index = GetIndex(key);
            Entry<K, V> current = table[index];
            while (current != null)
            {
                if (current.Key.Equals(key)) { current.Value = value; return; }
                current = current.Next;
            }
            Entry<K, V> newEntry = new Entry<K, V>(key, value);
            newEntry.Next = table[index];
            table[index] = newEntry;
            _size++;
        }

        public V get(object key)
        {
            int index = GetIndex(key);
            Entry<K, V> current = table[index];
            while (current != null)
            {
                if (current.Key.Equals(key)) return current.Value;
                current = current.Next;
            }
            return default(V);
        }

        public bool containsKey(object key)
        {
            int index = GetIndex(key);
            Entry<K, V> current = table[index];
            while (current != null)
            {
                if (current.Key.Equals(key)) return true;
                current = current.Next;
            }
            return false;
        }

        public List<K> getAllKeys()
        {
            List<K> keys = new List<K>();
            foreach (var node in table)
            {
                Entry<K, V> curr = node;
                while (curr != null) { keys.Add(curr.Key); curr = curr.Next; }
            }
            return keys;
        }

        private void Resize() { }
    }

    class Program
    {
        static void Main(string[] args)
        {
            string inputPath = "input.txt";
            string outputPath = "output.txt";

            MyHashMap<string, VariableInfo> varMap = new MyHashMap<string, VariableInfo>(16, 0.75f);

            string fileContent = File.ReadAllText(inputPath);

            string pattern = @"([a-zA-Z_]\w*)\s+([a-zA-Z_]\w*)\s*=\s*(\d+)\s*;";
            Regex regex = new Regex(pattern);

            MatchCollection matches = regex.Matches(fileContent);

            foreach (Match m in matches)
            {
                string typeStr = m.Groups[1].Value;
                string varName = m.Groups[2].Value;
                string valueStr = m.Groups[3].Value;

                VarType type = VarType.Invalid;
                if (typeStr == "int") type = VarType.Int;
                else if (typeStr == "float") type = VarType.Float;
                else if (typeStr == "double") type = VarType.Double;

                if (type == VarType.Invalid)
                {
                    Console.WriteLine($"Ошибка: Некорректный тип '{typeStr}' для переменной '{varName}'");
                    continue;
                }

                if (varMap.containsKey(varName))
                {
                    Console.WriteLine($"Ошибка: Переопределение переменной '{varName}' проигнорировано.");
                }
                else
                {
                    varMap.put(varName, new VariableInfo(type, typeStr, valueStr));
                }
            }

            using (StreamWriter sw = new StreamWriter(outputPath))
            {
                List<string> keys = varMap.getAllKeys();
                foreach (string name in keys)
                {
                    VariableInfo info = varMap.get(name);
                    sw.WriteLine($"{info.TypeName} => {name}({info.Value})");
                }
            }

            Console.WriteLine("Готово! Результат в output.txt");
            Console.ReadKey();
        }
    }
}
